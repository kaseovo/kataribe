KATARIBE_GEMINI_API_KEY=
KATARIBE_LIVE_MODEL=gemini-3.8-live
KATARIBE_TEXT_MODEL=gemini-3.8-flash
KATARIBE_DATA_DIR=var

# Deployed only. Closes everything but the family pages behind HTTP Basic
# (any user name, this password). Leave empty locally.
KATARIBE_TEAM_PASSWORD=

# Deployed only: keep everything in Firestore and Cloud Storage instead of
# SQLite and files under KATARIBE_DATA_DIR, which Cloud Run does not keep.
# KATARIBE_STORAGE=cloud
# KATARIBE_GCP_PROJECT=
# KATARIBE_RECORDINGS_BUCKET=
